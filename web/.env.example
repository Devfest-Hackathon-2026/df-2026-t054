# web/ で使う環境変数の名前だけを置く．値は書かない
# 使い方: cp .env.example .env して値を書く（.env はコミットしない）
# VITE_ 付きはビルドに埋め込まれてブラウザから読めるので，秘密の値を入れない

# Firebase の Web アプリ設定（Firebase コンソール → プロジェクトの設定 → マイアプリ）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true にすると Auth / Firestore エミュレータにつなぐ（ローカルの動作確認用．本番では空）
VITE_FIREBASE_EMULATOR=

# server/（Cloud Run）の URL．動画のステップ化などを呼ぶ
VITE_SERVER_URL=
