# server/ で使う環境変数の名前だけを置く．値は書かない
# 使い方: cp .env.example .env して値を書く（.env はコミットしない）．Cloud Functions のデプロイ時にも読まれる
# 認証はサービスアカウント鍵を置かず，ローカルでは `gcloud auth application-default login`，
# Cloud Functions（中身は Cloud Run）ではひもづいたサービスアカウントを使う
# GOOGLE_CLOUD_PROJECT は Cloud Functions が自動で入れる（予約済みの名前なので .env に書かない）

# Vertex AI（Gemini）を呼ぶリージョン．空なら global
GOOGLE_CLOUD_LOCATION=

# 使う Gemini のモデル名．空なら gemini-3.1-flash-lite（PoC #7 の申し送り）．下の種類ごとの値が空のときはステップ化にも使う
GEMINI_MODEL=

# ステップ化（投稿 → 思考ステップ）のモデルを投稿の種類ごとに変える．空なら GEMINI_MODEL → 既定（画像だけ gemini-3.8-flash）
GEMINI_MODEL_IMAGE=
GEMINI_MODEL_VIDEO=
GEMINI_MODEL_TEXT=

# 投稿のファイルがある Cloud Storage のバケット名．空なら Firebase の既定のバケット
GCS_BUCKET=

# Cloud Functions を置くリージョン．Firestore のデータベースの場所に合わせる．空なら asia-northeast1
FUNCTIONS_REGION=
