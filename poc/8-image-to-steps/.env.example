# このファイルを .env にコピーして値を入れる（.env はコミットしない）

# 使うモデル．空なら gemini-3.5-flash（npm run models で一覧できる）
GEMINI_MODEL=

# --- A. AI Studio（試すとき．無料枠．Google Cloud のクレジットは使えない） ---
# キーは課金を設定していないプロジェクトで作る．無料枠では入力がモデル改善に使われうるので，実在の学生の答案は送らない
GEMINI_API_KEY=

# --- B. Vertex AI（本番・クレジットを使うとき） ---
# true にすると GEMINI_API_KEY は使わず，ADC（gcloud auth application-default login）で認証する．空なら A を使う
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
# 空なら global
GOOGLE_CLOUD_LOCATION=

# 契約スキーマの場所．空なら shared/schema/thought-steps.schema.json を見る
CONTRACT_SCHEMA=
